SERVER_PORT=8080
# Export variables before running Spring Boot; this file is not auto-loaded.
# Public Nominatim explicitly approved by the developer for this small coursework prototype.
# Review https://operations.osmfoundation.org/policies/nominatim/ before use.
# Do not deploy multiple replicas against public providers (limits are application-wide).
PUBLIC_GEOCODING_ENABLED=true
GEOCODING_URL=https://nominatim.openstreetmap.org
ROUTING_URL=https://router.project-osrm.org
MAX_SNAP_METERS=300
TRAFFICEASE_USER_AGENT="TrafficEase-Coursework/0.2 (+https://github.com/ushanp02-maker/TrafficEase)"
# Health and M1 routing require no database or API credentials.
# Internal FastAPI connection; no external API credentials.
AI_SERVICE_URL=http://127.0.0.1:8000
