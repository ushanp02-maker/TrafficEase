# Empty means same-origin /api. Vite proxies this to the backend during development.
VITE_API_BASE=
# For Vite dev proxy only (server process variable):
BACKEND_PROXY_TARGET=http://127.0.0.1:8080
# Browser tiles use standard HTTP caching and visible OpenStreetMap attribution.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Production must reverse-proxy /api to Spring Boot on the same HTTPS origin.
