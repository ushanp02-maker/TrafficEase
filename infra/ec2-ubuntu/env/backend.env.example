# systemd EnvironmentFile, NOT a shell script. Keep root-owned mode 0640.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=framework
SERVER_TOMCAT_THREADS_MAX=40
SERVER_TOMCAT_ACCEPT_COUNT=20
AI_SERVICE_URL=http://127.0.0.1:8000
PUBLIC_GEOCODING_ENABLED=true
GEOCODING_URL=https://nominatim.openstreetmap.org
ROUTING_URL=https://router.project-osrm.org
MAX_SNAP_METERS=300
TRAFFICEASE_USER_AGENT="TrafficEase-Coursework/0.2 (+https://github.com/ushanp02-maker/TrafficEase)"
# No database credentials: default profile does not connect; see docs/persistence.md for the optional profile.
