# Initial ACME-only site: do not serve the app over public plaintext HTTP.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    listen 80;
    server_name __DOMAIN__;
    location ^~ /.well-known/acme-challenge/ { root /var/lib/letsencrypt; }
    location / { return 503 "HTTPS setup required.\n"; }
}
